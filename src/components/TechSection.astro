---
const stack = [".NET 10", "C# 13", "Avalonia UI 12.1", "Licencia MIT"];

const features = [
	{
		tag: "Extracción",
		title: "yt-dlp y ffmpeg empaquetados",
		body: "No instalas nada aparte. La app trae los binarios dentro y los actualiza contigo. Pega la URL y obtienes un MP3 limpio con metadatos.",
		source: "Motor de descarga",
	},
	{
		tag: "Reproducción",
		title: "Un reproductor de verdad",
		body: "Cola, portada, forma de onda y control de volumen en una interfaz moderna. La reproducción usa libVLC, así que suena igual en las tres plataformas.",
		source: "Interfaz Avalonia",
	},
	{
		tag: "Distribución",
		title: "Binario ligero, sin runtime",
		body: "Publicado como ejecutable autocontenido: instalador por usuario en Windows, .dmg en macOS y paquete en el AUR para Arch y CachyOS.",
		source: "Releases de GitHub",
	},
];
---

<section id="tecnologia" class="bg-paper py-16 sm:py-28">
	<div class="mx-auto max-w-7xl px-5 sm:px-8">
		<div class="grid gap-6 lg:grid-cols-[1fr_2fr] lg:gap-16">
			<p class="eyebrow">Construido con</p>
			<div>
				<h2 class="max-w-2xl text-2xl font-bold tracking-tight sm:text-4xl md:text-[2.75rem] md:leading-[1.1]">
					Tecnología moderna, aplicación diminuta.
				</h2>
				<ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
					{
						stack.map((s) => (
							<li class="flex items-center gap-2 text-sm font-medium text-ink-soft">
								<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-ink">
									<path d="m20 6-11 11-5-5" />
								</svg>
								{s}
							</li>
						))
					}
				</ul>
			</div>
		</div>

		<div class="mt-10 grid gap-6 sm:grid-cols-2 md:mt-14 md:grid-cols-3">
			{
				features.map((f) => (
					<article class="flex flex-col rounded-2xl border border-hairline bg-card p-6">
						<div class="flex items-center justify-between">
							<span class="grid h-11 w-11 place-items-center rounded-full bg-ink text-paper">
								<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
									<path d="M12 3v10.55A4 4 0 1 0 14 17V7h4V3h-6Z" />
								</svg>
							</span>
							<span class="chip">{f.tag}</span>
						</div>
						<h3 class="mt-5 text-lg font-semibold leading-snug">
							&ldquo;{f.title}&rdquo;
						</h3>
						<p class="mt-2 flex-1 text-sm leading-relaxed text-ink-soft">{f.body}</p>
						<div class="mt-5 flex items-center justify-between border-t border-hairline pt-4">
							<span class="text-xs font-medium text-ink-soft">{f.source}</span>
							<span class="text-xs font-semibold text-ink">Incluido</span>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>