---
import DownloadPicker from "./DownloadPicker.tsx";
---

<section id="top" class="bg-night">
	<div class="mx-auto flex min-h-svh max-w-7xl flex-col justify-center px-5 pt-24 pb-16 sm:px-8 sm:pt-28 sm:pb-20">
		<p class="eyebrow text-white/55">Music · MP3 · Código abierto</p>

		<h1
			class="wordmark mt-4 text-white text-[clamp(2.75rem,13vw,12rem)]"
		>
			Downloader
		</h1>

		<div class="mt-6 max-w-xl">
			<h2 class="text-xl font-semibold text-white sm:text-2xl">
				Convierte cualquier vídeo de YouTube en un MP3.
			</h2>
			<p class="mt-3 text-sm leading-relaxed text-white/60 sm:text-base">
				App de escritorio para Windows, macOS y Linux. Descarga el audio en alta
				calidad y escúchalo en un reproductor moderno — <span class="text-white/80"
					>yt-dlp y ffmpeg ya vienen incluidos</span
				>.
			</p>
		</div>

		<div class="mt-7 sm:mt-8">
			<DownloadPicker client:load />
		</div>

		<dl class="mt-8 flex flex-wrap gap-x-8 gap-y-4 text-white sm:mt-10 sm:gap-x-10">
			{
				[
					["3", "sistemas operativos"],
					["320", "kbps máx. de audio"],
					["0", "anuncios · 0 tracking"],
				].map(([n, l]) => (
					<div>
						<dt class="text-2xl font-bold tracking-tight">{n}</dt>
						<dd class="text-xs text-white/50">{l}</dd>
					</div>
				))
			}
		</dl>
	</div>
</section>