---
import AppMock from "./AppMock.astro";

const platforms = [
	{
		name: "Windows",
		detail: "Instalador .exe · Windows 10 / 11",
		note: "Instalación por usuario, sin permisos de administrador.",
	},
	{
		name: "macOS",
		detail: "Apple Silicon e Intel · macOS 12+",
		note: "Imagen .dmg universal lista para arrastrar a Aplicaciones.",
	},
	{
		name: "Linux",
		detail: "AUR · Arch Linux / CachyOS",
		note: "yay -S music-mp3-downloader-bin y a descargar.",
	},
];
---

<section id="caracteristicas" class="bg-paper py-16 sm:py-28">
	<div class="mx-auto max-w-7xl px-5 sm:px-8">
		<div class="grid gap-6 lg:grid-cols-[1fr_2fr] lg:gap-16">
			<p class="eyebrow">Multiplataforma · .NET 10 + Avalonia UI</p>
			<h2 class="max-w-2xl text-2xl font-bold tracking-tight sm:text-4xl md:text-[2.75rem] md:leading-[1.1]">
				Descarga audio en MP3 desde cualquier enlace de YouTube y guárdalo en una
				biblioteca que se ve tan bien como suena.
			</h2>
		</div>

		<div class="mt-10 grid gap-6 sm:grid-cols-2 md:mt-14 md:grid-cols-3">
			{
				platforms.map((p) => (
					<article class="flex flex-col rounded-2xl border border-hairline bg-card p-4">
						<AppMock size="sm" class="mb-5" />
						<h3 class="text-lg font-semibold">{p.name}</h3>
						<p class="mt-0.5 text-sm text-ink-soft">{p.detail}</p>
						<p class="mt-3 text-xs leading-relaxed text-ink-soft/80">{p.note}</p>
						<div class="mt-4 h-px w-2/3 bg-linear-to-r from-ink/40 to-transparent" />
					</article>
				))
			}
		</div>

		<div class="mt-10 flex justify-center sm:mt-12">
			<a
				href="#instalacion"
				class="btn btn-dark btn-lg w-full max-w-xs sm:w-auto sm:max-w-none"
				>Ver todas las descargas</a
			>
		</div>
	</div>
</section>