---
const items = [
	"yt-dlp incluido",
	"ffmpeg incluido",
	"Reproductor con forma de onda",
	"Cola de descargas",
	"Metadatos y portada",
	"Sin anuncios",
	"Licencia MIT",
	"100 % offline tras instalar",
];
---

<div class="border-y border-hairline bg-bone">
	<div
		class="mx-auto flex max-w-7xl flex-wrap items-center justify-center gap-x-4 gap-y-2 px-5 py-4 sm:gap-x-6 sm:gap-y-3 sm:px-8"
	>
		{
			items.map((item, i) => (
				<>
					{i > 0 && <span class="text-hairline">/</span>}
					<span class="text-xs font-medium tracking-wide text-ink-soft">{item}</span>
				</>
			))
		}
	</div>
</div>