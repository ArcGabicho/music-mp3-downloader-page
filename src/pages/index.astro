---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";

import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Marquee from "../components/Marquee.astro";
import ValueProp from "../components/ValueProp.astro";
import OsSection from "../components/OsSection.astro";
import TechSection from "../components/TechSection.astro";
import InstallCta from "../components/InstallCta.astro";
import Footer from "../components/Footer.astro";
import ToasterMount from "../components/ToasterMount.tsx";
---

<Layout>
	<Nav />
	<main>
		<Hero />
		<Marquee />
		<ValueProp />
		<OsSection />
		<TechSection />
		<InstallCta />
	</main>
	<Footer />
	<ToasterMount client:load />
</Layout>